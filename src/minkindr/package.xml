<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>minkindr</name>
  <version>1.0.0</version>
  <description>
    Header-only vendoring of ETH Zurich minkindr (kindr/minimal) minimal
    transformation library, provided as an ament INTERFACE library for the
    EVO port.
  </description>
  <maintainer email="info@dotxautomation.com">dotX Automation</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen3_cmake_module</depend>
  <depend>eigen</depend>
  <depend>libgoogle-glog-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
